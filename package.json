{
  "name": "dsh-task-journal",
  "version": "0.1.0",
  "description": "任务日志插件：把会话里的任务与工作结果自动写到本地文件（Markdown 日志 + JSONL 事件流），并提供一个 journal 工具让模型主动记录。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-journal": "bin/dsh-journal.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "bin",
    "cordis.patch.yml",
    "lib"
  ],
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "journal",
    "task-log",
    "worklog"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:q785845530/dsh-task-journal.git"
  },
  "homepage": "https://github.com/q785845530/dsh-task-journal",
  "bugs": {
    "url": "https://github.com/q785845530/dsh-task-journal/issues"
  },
  "mirrors": {
    "gitee": "https://gitee.com/wasen/dsh-task-journal"
  },
  "scripts": {
    "verify:startup": "node verify-startup.mjs"
  }
}